# BluetoothCore uses Bluedroid GATT and the BLE 4.2 advertising APIs.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_42_ADV_EN=y

# Leave room for the Bluetooth and Wi-Fi firmware in a 2 MB factory partition.
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# RAM budget for UDP LED streaming and a single BLE GATT server connection.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_BT_GATTC_ENABLE=n
CONFIG_BT_GATT_MAX_SR_PROFILES=4
CONFIG_BT_GATT_MAX_SR_ATTRIBUTES=32
CONFIG_BT_LE_MAX_CONNECTIONS=1
CONFIG_BT_LE_EXT_ADV=n
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
